<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <gazebo reference="rear_left_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    </gazebo>

    <gazebo reference="rear_right_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    </gazebo>

    <gazebo reference="front_left_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    </gazebo>

    <gazebo reference="front_right_wheel_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    </gazebo>
    
  

    <gazebo>
        <plugin
            filename="gz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
            <front_left_joint>base_front_left_wheel</front_left_joint>
            <front_right_joint>base_front_right_wheel</front_right_joint>
            <back_left_joint>base_rear_left_wheel</back_left_joint>
            <back_right_joint>base_rear_right_wheel</back_right_joint>
            <wheelbase>0.306666</wheelbase>
            <wheel_separation>0.4</wheel_separation>
            <wheel_radius>0.08</wheel_radius>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>
    </gazebo>

   

    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_rear_left_wheel</joint_name>
            <joint_name>base_rear_right_wheel</joint_name>
            <joint_name>base_front_left_wheel</joint_name>
            <joint_name>base_front_right_wheel</joint_name>
        </plugin>
    </gazebo>

    
</robot>