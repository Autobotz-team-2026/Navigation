<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>scara_base_first_support_joint</joint_name>
            <topic>/model/orion/joint/scara_arm_joint/0/cmd_pos</topic>
            <p_gain>50.0</p_gain> <i_gain>25.0</i_gain>  <d_gain>5.0</d_gain>
            <i_max>15.0</i_max>    <i_min>-15.0</i_min>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>first_support_movable_scara_joint</joint_name>
            <topic>/model/orion/joint/scara_height_joint/0/cmd_pos</topic>
            <p_gain>300.0</p_gain> <i_gain>250.0</i_gain>  <d_gain>90.0</d_gain>
            <i_max>150.0</i_max>    <i_min>-150.0</i_min>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>arm_joint</joint_name>
            <topic>/model/orion/joint/scara_arm_joint/1/cmd_pos</topic>
            <p_gain>100.0</p_gain> <i_gain>50.0</i_gain>  <d_gain>15.0</d_gain>
            <i_max>15.0</i_max>    <i_min>-15.0</i_min>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>arm2_base_gripper_joint</joint_name>
            <topic>/model/orion/joint/scara_claw_rotation_joint/0/cmd_pos</topic>
            <p_gain>150.0</p_gain> <i_gain>0.50</i_gain>  <d_gain>15.0</d_gain>
            <i_max>15.0</i_max>    <i_min>-15.0</i_min>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>base_right_gripper_joint</joint_name>
            <topic>/model/orion/joint/scara_gripper/right/cmd_pos</topic>
            <p_gain>500.0</p_gain> 
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>base_left_gripper_joint</joint_name>
            <topic>/model/orion/joint/scara_gripper/left/cmd_pos</topic>
            <p_gain>500.0</p_gain> 
        </plugin>
    </gazebo>

    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>scara_base_first_support_joint</joint_name>
            <joint_name>first_support_movable_scara_joint</joint_name>
            <joint_name>arm_joint</joint_name>
            <joint_name>arm2_base_gripper_joint</joint_name>
            <joint_name>base_right_gripper_joint</joint_name>
            <joint_name>base_left_gripper_joint</joint_name>
        </plugin>
    </gazebo>
</robot>