    <gazebo>
        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <publish_odom_tf>true</publish_odom_tf> 
        </plugin>

        <plugin
            filename="gz-sim-label-system"
            name="gz::sim::systems::Label">
        </plugin>

        <plugin
            filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
            <initial_linear_velocity>0 0 0</initial_linear_velocity>
            <initial_angular_velocity>0 0 0</initial_angular_velocity>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_rear_left_wheel</joint_name>
            <joint_name>base_rear_right_wheel</joint_name>
            <joint_name>base_front_left_wheel</joint_name>
            <joint_name>base_front_right_wheel</joint_name>
        </plugin>
    </gazebo>

    <gazebo>
