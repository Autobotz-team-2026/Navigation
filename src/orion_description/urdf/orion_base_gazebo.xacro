<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <gazebo>
        <plugin
            filename="gz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
            <front_left_joint>base_front_left_wheel</front_left_joint>
            <front_right_joint>base_front_right_wheel</front_right_joint>
            <back_left_joint>base_rear_left_wheel</back_left_joint>
            <back_right_joint>base_rear_right_wheel</back_right_joint>
            <wheelbasev>0.306666</wheelbasev>
            <wheel_separation>0.4</wheel_separation>
            <wheel_radius>0.08</wheel_radius>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_rear_left_wheel</joint_name>
            <joint_name>base_rear_right_wheel</joint_name>
            <joint_name>base_front_left_wheel</joint_name>
            <joint_name>base_front_right_wheel</joint_name>
            <joint_name>scara_base_first_support_joint</joint_name>
            <joint_name>first_support_movable_scara_joint</joint_name>
            <joint_name>arm_joint</joint_name>
            <joint_name>arm2_base_gripper_joint</joint_name>
            <joint_name>base_right_gripper_joint</joint_name>
            <joint_name>base_left_gripper_joint</joint_name>
        </plugin>
    </gazebo>
    
    <gazebo reference="lidar_link">
        <sensor name = "lidar" type="gpu_lidar">
            <topic>scan</topic>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                    <samples>360</samples>
                    <min_angle>-0.7854</min_angle>
                    <max_angle>0.7854</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>10</max>
                </range>
            </lidar>
            <gz_frame_id>lidar_link</gz_frame_id>
        </sensor>
    </gazebo>
</robot>
