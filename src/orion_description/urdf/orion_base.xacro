<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.7"/>
    <xacro:property name="base_width" value ="0.4"/>
    <xacro:property name="base_height" value="0.25"/>
    <xacro:property name="wheel_radius" value="0.08"/>
    <xacro:property name="wheel_length" value="0.05"/>
    <xacro:property name="support_length" value="0.15"/>
    <xacro:property name="support_width" value="0.25"/>
    <xacro:property name="support_height" value="0.05"/>
    <xacro:property name="lidar_radius" value="0.05"/>
    <xacro:property name="lidar_length" value="0.08"/>

    <xacro:property name="base_mass" value="10.0"/>
    <xacro:property name="wheel_mass" value="1.5"/>
    <xacro:property name="support_lidar_mass" value="0.3"/>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}" 
                                    o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0"/>
        </link>
    </xacro:macro>

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="white"/>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 ${base_height/2.0}" o_rpy="0 0 0"/>
    </link>

    <xacro:wheel_link prefix="rear_left"/>

    <xacro:wheel_link prefix="rear_right"/>

    <xacro:wheel_link prefix="front_left"/>

    <xacro:wheel_link prefix="front_right"/>

    <link name="support_link">
        <visual>
            <geometry>
                <box size="${support_length} ${support_width} ${support_height}"/>
            </geometry>
            <material name="white"/>
            <origin xyz="${support_length/2} 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <box size="${support_length} ${support_width} ${support_height}"/>
            </geometry>
            <origin xyz="${support_length/2} 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="${support_lidar_mass}" x="${support_length}" y="${support_width}" z="${support_height}"
                           o_xyz="${support_length/2} 0 0" o_rpy="0 0 0"/>
    </link>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
            <material name="yellow"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
    </link>

    --------------------------------------------------

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_rear_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel_link"/>
        <origin xyz="${-base_length/3} ${(base_width/2)+(wheel_length/2)} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <gazebo reference="base_rear_left_wheel">
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2> </ode>
                </friction>
            </surface>
        </gazebo>
    </joint>

    <joint name="base_rear_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel_link"/>
        <origin xyz="${-base_length/3} ${(-base_width/2)-(wheel_length/2)} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <gazebo reference="base_rear_right_wheel">
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2> </ode>
                </friction>
            </surface>
        </gazebo>
    </joint>

    <joint name="base_front_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel_link"/>
        <origin xyz="${base_length/3} ${(base_width/2)+(wheel_length/2)} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <gazebo reference="base_front_left_wheel">
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2> </ode>
                </friction>
            </surface>
        </gazebo>
    </joint>

    <joint name="base_front_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel_link"/>
        <origin xyz="${base_length/3} ${(-base_width/2)-(wheel_length/2)} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <gazebo reference="base_front_right_wheel">
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.0</mu2> </ode>
                </friction>
            </surface>
        </gazebo>
    </joint>

    <joint name="base_support" type="fixed">
        <parent link="base_link"/>
        <child link="support_link"/>
        <origin xyz="${(base_length/2)} 0 ${support_height/2}" rpy="0 0 0"/>
    </joint>

    <joint name="lidar_support" type="fixed">
        <parent link="support_link"/>
        <child link="lidar_link"/>
        <origin xyz="${support_length/2} 0 ${(support_height/2)+(lidar_length/2)}" rpy="0 0 0"/>
    </joint>

</robot>
