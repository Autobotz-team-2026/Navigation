<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="imu_sensor" params="prefix parent xyz">
        <link name="imu_${prefix}_link"/>
        <joint name="imu_${prefix}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="imu_${prefix}_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>
        <gazebo reference="imu_${prefix}_link">
            <sensor name="imu_${prefix}" type="imu">
                <always_on>1</always_on>
                <update_rate>100</update_rate>
                <topic>imu_${prefix}</topic>
                <gz_frame_id>imu_${prefix}_link</gz_frame_id>
            </sensor>
        </gazebo>
    </xacro:macro>

    <gazebo>
        <plugin filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu"/>
    </gazebo>

    <xacro:imu_sensor prefix="base" parent="base_link" xyz="0 0 ${base_height}"/>
    <xacro:imu_sensor prefix="arm1" parent="arm_1_link" xyz="0 0 0"/>
    <xacro:imu_sensor prefix="arm2" parent="arm_2_link" xyz="0 0 0"/>
    <xacro:imu_sensor prefix="gripper" parent="base_gripper_link" xyz="0 0 0"/>

</robot>